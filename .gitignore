# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/
.ipynb_checkpoints/

# ---- R ----
.Rhistory
.RData
.Rproj.user/

# ---- Editors / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- Secrets and experiment logs ----
.env
*.netrc
wandb/

